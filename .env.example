# Copy to ocr_config.json or export these env vars. Never commit real keys.

# --- Primary (OpenAI-compatible) ---
OCR_API_KEY=your-rewrite-here
OCR_BASE_URL=https://api.llm.ustc.edu.cn/v1
OCR_MODEL=glm-4v-flash
# Optional provider preset: ustc | openai | custom
OCR_PROVIDER=ustc

# Alias accepted if OCR_API_KEY is empty
# USTC_API_KEY=your-rewrite-here

# --- Tesseract adapter (local OCR, no API key) ---
# Language pack(s) to use, e.g. chi_sim, eng, chi_sim+eng
OCR_TESS_LANG=chi_sim
# Page segmentation mode (0-13) and engine mode (0-3); usually leave default
# OCR_TESS_PSM=3
# OCR_TESS_OEM=3
# Path to tessdata if it is not in the default location
# OCR_TESSDATA_DIR=/usr/share/tesseract/tessdata
# Absolute path to the tesseract binary if it is not on PATH
# OCR_TESS_CMD=/usr/bin/tesseract

# --- Generic OpenAI adapter (custom vision model) ---
# Optional custom prompt overriding the default bbox-JSON instructions
# OCR_GENERIC_PROMPT=...